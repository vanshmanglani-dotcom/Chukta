# Required
DATABASE_URL=postgresql://...            # Neon pooled connection string
SESSION_SECRET=                          # 32+ random chars: openssl rand -hex 32
CRON_SECRET=                             # Vercel sends this as a Bearer token to /api/cron/run
ADMIN_SECRET=                            # Protects the platform kill switch API

# AI (required). On Vercel, AI Gateway auth works automatically via OIDC.
# Locally, set AI_GATEWAY_API_KEY from Vercel > AI Gateway > API keys.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.5

# Email auto-send (optional; without it, routine reminders come to the owner's queue)
RESEND_API_KEY=
EMAIL_FROM="Chukta Reminders <reminders@yourdomain.in>"

# Failsafes
KILL_SWITCH=0          # 1 = nothing drafts or sends (needs redeploy to take effect)
DRY_RUN=0              # 1 = draft everything, send nothing
MAX_AI_DRAFTS_PER_RUN=100
MAX_SENDS_PER_RUN=200
APP_URL=               # e.g. https://chukta.vercel.app (defaults to the Vercel production URL)
